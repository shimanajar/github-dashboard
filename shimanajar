    <!-- ================= JAVASCRIPT ================= -->
    <script>
        document.addEventListener("DOMContentLoaded", () => {
            lucide.createIcons();

            // ============================================================
            // GITHUB CONFIGURATION
            // ============================================================
            const GITHUB_USERNAME = "shimanajar";
const GITHUB_API = "https://api.github.com";

            // ============================================================
            // THEME SWITCHER
            // ============================================================
            const themeBtn = document.getElementById("themeSelectBtn");
            const themeDropdown = document.getElementById("themeDropdown");
            const themeOptions = document.querySelectorAll(".theme-option");
            const currentThemeLabel = document.getElementById("currentThemeLabel");
            const savedTheme = localStorage.getItem("gh_dashboard_theme") || "cyberpunk";

            setTheme(savedTheme);

// Time-aware greeting
const hour = new Date().getHours();
document.getElementById("greetingText").textContent =
    hour < 5  ? "Still up" :
    hour < 12 ? "Good morning" :
    hour < 18 ? "Good afternoon" :
                "Good evening";

            themeBtn.addEventListener("click", (e) => {
                e.stopPropagation();
                themeDropdown.classList.toggle("show");
            });

            document.addEventListener("click", () => themeDropdown.classList.remove("show"));

            themeOptions.forEach(option => {
                option.addEventListener("click", () => {
                    const chosenTheme = option.dataset.theme;
                    setTheme(chosenTheme);
                    localStorage.setItem("gh_dashboard_theme", chosenTheme);
                });
            });

            function setTheme(themeName) {
                document.documentElement.setAttribute("data-theme", themeName);
                themeOptions.forEach(opt => {
                    const active = opt.dataset.theme === themeName;
                    opt.classList.toggle("active", active);
                    if (active) currentThemeLabel.textContent = opt.querySelector("span").textContent.split(" ")[0];
                });
            }

            // ============================================================
            // GITHUB API
            // ============================================================
            async function fetchGitHub(url) {
                const response = await fetch(url, {
                    headers: {
                        "Accept": "application/vnd.github+json"
                    }
                });

                if (!response.ok) {
                    throw new Error(`GitHub API error: ${response.status}`);
                }

                return response.json();
            }

            async function loadGitHubDashboard() {
                try {
                    const [user, repos, events] = await Promise.all([
                        fetchGitHub(`${GITHUB_API}/users/${GITHUB_USERNAME}`),
                        fetchGitHub(`${GITHUB_API}/users/${GITHUB_USERNAME}/repos?per_page=100&sort=updated`),
                        fetchGitHub(`${GITHUB_API}/users/${GITHUB_USERNAME}/events/public?per_page=10`)
                    ]);

                    updateProfile(user);
                    updateStats(user, repos);
                    renderRepositories(repos);
                    renderActivity(events);
                    renderSkills(repos);

                    console.log("GitHub dashboard loaded:", user.login);
                } catch (error) {
                    console.error(error);
                    showGitHubError(error);
                }
            }

            function updateProfile(user) {
                const name = user.name || user.login;
                document.getElementById("displayName").textContent = name;
                document.getElementById("miniProfileName").textContent = name;
                document.getElementById("profileSubtitle").textContent = user.bio || `@${user.login} · GitHub developer profile`;

                const topAvatar = document.getElementById("topAvatar");
                topAvatar.textContent = "";
                topAvatar.style.backgroundImage = `url(${user.avatar_url})`;
                topAvatar.style.backgroundSize = "cover";
                topAvatar.style.backgroundPosition = "center";

                const miniAvatar = document.querySelector(".profile-mini .avatar");
                if (miniAvatar) {
                    miniAvatar.textContent = "";
                    miniAvatar.style.backgroundImage = `url(${user.avatar_url})`;
                    miniAvatar.style.backgroundSize = "cover";
                    miniAvatar.style.backgroundPosition = "center";
                }
            }

            function updateStats(user, repos) {
                const totalStars = repos.reduce((sum, repo) => sum + (repo.stargazers_count || 0), 0);
                document.getElementById("statRepos").textContent = user.public_repos;
                document.getElementById("statStars").textContent = totalStars;
                document.getElementById("statFollowers").textContent = user.followers;

                // The public REST API does not expose the full contribution graph.
                // Reuse the jogruber API to get the total for the current year
fetch(`https://github-contributions-api.jogruber.de/v4/${GITHUB_USERNAME}?y=last`)
    .then(r => r.json())
    .then(d => {
        const days = d.contributions || [];
        const total = days.reduce((s, day) => s + (day.count || 0), 0);
        document.getElementById("statContribs").textContent = total.toLocaleString();
    })
    .catch(() => {
        document.getElementById("statContribs").textContent = "—";
    });
            }

            function renderRepositories(repos) {
                const grid = document.getElementById("projectsGrid");
                grid.innerHTML = "";

                if (!repos.length) {
                    grid.innerHTML = `<div class="project-card" style="grid-column:1/-1;"><div class="project-details"><h3>No public repositories</h3><p>This GitHub profile currently has no public repositories.</p></div></div>`;
                    return;
                }

                repos.slice(0, 6).forEach((repo, index) => {
                    const card = document.createElement("a");
                    card.className = "project-card";
                    card.href = repo.html_url;
                    card.target = "_blank";
                    card.rel = "noopener noreferrer";
                    card.dataset.category = index < 2 ? "building" : "active";
                    card.style.textDecoration = "none";
                    card.style.color = "inherit";

                    const description = repo.description || "No description provided.";
                    const language = repo.language || "Code";

                    card.innerHTML = `
                        <div class="project-icon-box"><i data-lucide="folder-git-2"></i></div>
                        <div class="project-details">
                            <h3>${escapeHtml(repo.name)}</h3>
                            <p>${escapeHtml(description)}</p>
                            <div class="project-tags">
                                <span class="status-active">● Public</span>
                                <span style="color:var(--text-muted)">${escapeHtml(language)}</span>
                                <span style="color:var(--text-muted)">★ ${repo.stargazers_count}</span>
                            </div>
                        </div>`;

                    grid.appendChild(card);
                });

                lucide.createIcons();
                applyProjectFilter();
            }

            function renderActivity(events) {
                const feed = document.getElementById("activityFeed");
                feed.innerHTML = "";

                const usefulEvents = events.filter(event =>
                    ["PushEvent", "CreateEvent", "IssuesEvent", "PullRequestEvent", "WatchEvent"].includes(event.type)
                ).slice(0, 5);

                if (!usefulEvents.length) {
                    feed.innerHTML = `<div class="activity-item"><div class="activity-dot-line"><div class="act-dot"></div></div><div class="activity-info"><strong>No recent public activity</strong><small>GitHub did not return recent public events.</small></div></div>`;
                    return;
                }

                usefulEvents.forEach(event => {
                    const item = document.createElement("div");
                    item.className = "activity-item";
                    item.innerHTML = `
                        <div class="activity-dot-line"><div class="act-dot"></div></div>
                        <div class="activity-info">
                            <strong>${escapeHtml(formatEvent(event))}</strong>
                            <small>${timeAgo(event.created_at)}</small>
                        </div>`;
                    feed.appendChild(item);
                });
            }

            function formatEvent(event) {
                const repo = event.repo?.name || "a repository";
                if (event.type === "PushEvent") {
                    const count = event.payload?.commits?.length || 1;
                    return `Pushed ${count} commit${count === 1 ? "" : "s"} to ${repo}`;
                }
                if (event.type === "CreateEvent") return `Created ${event.payload?.ref_type || "content"} in ${repo}`;
                if (event.type === "IssuesEvent") return `${event.payload?.action || "Updated"} an issue in ${repo}`;
                if (event.type === "PullRequestEvent") return `${event.payload?.action || "Updated"} a pull request in ${repo}`;
                if (event.type === "WatchEvent") return `Starred ${repo}`;
                return `Activity in ${repo}`;
            }

            function timeAgo(dateString) {
                const seconds = Math.floor((Date.now() - new Date(dateString).getTime()) / 1000);
                if (seconds < 60) return "Just now";
                const minutes = Math.floor(seconds / 60);
                if (minutes < 60) return `${minutes} min ago`;
                const hours = Math.floor(minutes / 60);
                if (hours < 24) return `${hours} hr${hours === 1 ? "" : "s"} ago`;
                const days = Math.floor(hours / 24);
                if (days < 30) return `${days} day${days === 1 ? "" : "s"} ago`;
                return new Date(dateString).toLocaleDateString();
            }

            async function renderSkills(repos) {
                const languageTotals = {};

                await Promise.all(repos.slice(0, 10).map(async repo => {
                    if (!repo.languages_url) return;
                    try {
                        const languages = await fetchGitHub(repo.languages_url);
                        Object.entries(languages).forEach(([language, bytes]) => {
                            languageTotals[language] = (languageTotals[language] || 0) + bytes;
                        });
                    } catch (error) {
                        console.warn("Could not load languages for", repo.name);
                    }
                }));

                const entries = Object.entries(languageTotals).sort((a, b) => b[1] - a[1]).slice(0, 4);
                const skillItems = document.querySelectorAll(".skill-item");
                const max = entries[0]?.[1] || 1;

                skillItems.forEach((item, index) => {
                    const info = item.querySelector(".skill-info");
                    const bar = item.querySelector(".skill-bar-fill");
                    if (!entries[index]) {
                        item.style.display = "none";
                        return;
                    }

                    const [language, bytes] = entries[index];
                    const percentage = Math.max(10, Math.round((bytes / max) * 100));
                    info.innerHTML = `<span>${escapeHtml(language)}</span><span>${percentage}%</span>`;
                    bar.dataset.progress = `${percentage}%`;
                    bar.style.width = `${percentage}%`;
                    item.style.display = "block";
                });
            }

            function escapeHtml(value) {
                return String(value).replace(/[&<>"']/g, char => ({
                    "&": "&amp;", "<": "&lt;", ">": "&gt;",
                    '"': "&quot;", "'": "&#039;"
                }[char]));
            }

            function showGitHubError(error) {
                document.getElementById("profileSubtitle").textContent = "Unable to load GitHub data. Check your internet connection and try again.";
                document.getElementById("projectsGrid").innerHTML = `
                    <div class="project-card" style="grid-column:1/-1;">
                        <div class="project-icon-box"><i data-lucide="wifi-off"></i></div>
                        <div class="project-details">
                            <h3>GitHub connection failed</h3>
                            <p>${escapeHtml(error.message)}</p>
                        </div>
                    </div>`;
                lucide.createIcons();
            }

async function loadRealHeatmap(year) {
    const heatmap = document.getElementById("heatmap");
    const tooltip = document.getElementById("tooltip");
    heatmap.innerHTML = "";

    try {
        const res = await fetch(
            `https://github-contributions-api.jogruber.de/v4/${GITHUB_USERNAME}?y=${year}`
        );
        const data = await res.json();
        const days = data.contributions || [];

        days.forEach(day => {
            const cell = document.createElement("div");
            cell.classList.add("heat-cell");
            const count = day.count;
            if (count >= 12) cell.classList.add("heat-4");
            else if (count >= 7) cell.classList.add("heat-3");
            else if (count >= 3) cell.classList.add("heat-2");
            else if (count > 0) cell.classList.add("heat-1");

            cell.addEventListener("mouseenter", () => {
                tooltip.style.display = "block";
                tooltip.innerHTML = `<strong>${count} contribution${count === 1 ? "" : "s"}</strong><br>${day.date}`;
            });
            cell.addEventListener("mousemove", e => {
                tooltip.style.left = e.pageX + 12 + "px";
                tooltip.style.top = e.pageY + 12 + "px";
            });
            cell.addEventListener("mouseleave", () => tooltip.style.display = "none");

            heatmap.appendChild(cell);
        });
    } catch (err) {
        console.warn("Heatmap failed:", err);
        heatmap.innerHTML = `<p style="color:var(--text-muted);font-size:12px;">Could not load contributions.</p>`;
    }
}

loadRealHeatmap(new Date().getFullYear());

document.getElementById("yearSelect").addEventListener("change", (e) => {
    loadRealHeatmap(e.target.value);
});

            // ============================================================
            // PROJECT FILTERS
            // ============================================================
            const tagBtns = document.querySelectorAll(".tag-btn");
            tagBtns.forEach(btn => {
                btn.addEventListener("click", () => {
                    tagBtns.forEach(b => b.classList.remove("active"));
                    btn.classList.add("active");
                    applyProjectFilter(btn.dataset.filter);
                });
            });

            function applyProjectFilter(filter = document.querySelector(".tag-btn.active")?.dataset.filter || "all") {
                document.querySelectorAll(".project-card").forEach(card => {
                    if (filter === "all" || card.dataset.category === filter) card.style.display = "flex";
                    else card.style.display = "none";
                });
            }

            // ============================================================
            // NAVIGATION + NOTIFICATION
            // ============================================================
document.querySelectorAll(".nav-item").forEach(item => {
    item.addEventListener("click", () => {
        document.querySelectorAll(".nav-item").forEach(n => n.classList.remove("active"));
        item.classList.add("active");

        const target = document.getElementById(item.dataset.section);
        if (target) {
            target.scrollIntoView({ behavior: "smooth", block: "start" });
        }
    });
});

            document.getElementById("notifyBtn").addEventListener("click", () => {
                tooltip.style.display = "block";
                tooltip.innerHTML = "🔔 Dashboard is connected to GitHub";
                const rect = document.getElementById("notifyBtn").getBoundingClientRect();
                tooltip.style.left = rect.left - 120 + "px";
                tooltip.style.top = rect.bottom + 10 + "px";
                setTimeout(() => tooltip.style.display = "none", 2500);
            });

// Start loading real GitHub data.
loadGitHubDashboard();
        });
    </script>
