<!DOCTYPE html>
<html lang="en" data-theme="cyberpunk">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>GitHub Dashboard - Modern Refactor</title>

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet">

    <!-- Lucide Icons CDN -->
    <script src="https://unpkg.com/lucide@latest"></script>

    <style>
        :root[data-theme="cyberpunk"] {
            --bg-primary: #090812;
            --bg-secondary: #0f0c1e;
            --bg-card: rgba(21, 17, 40, 0.7);
            --bg-card-hover: rgba(30, 24, 58, 0.85);
            --bg-input: #181330;
            --border: rgba(168, 85, 247, 0.2);
            --border-hover: rgba(236, 72, 153, 0.5);
            --text-main: #f3f4f6;
            --text-muted: #9ca3af;
            --accent-primary: #ec4899;
            --accent-secondary: #a855f7;
            --accent-tertiary: #06b6d4;
            --accent-glow: rgba(236, 72, 153, 0.25);
            --heat-0: #16122c;
            --heat-1: #3b1c63;
            --heat-2: #701a75;
            --heat-3: #a21caf;
            --heat-4: #f43f5e;
            --status-active: #10b981;
            --status-building: #f59e0b;
            --card-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.4);
            --font-mono: 'JetBrains Mono', monospace;
        }

        :root[data-theme="github-dark"] {
            --bg-primary: #0d1117;
            --bg-secondary: #161b22;
            --bg-card: rgba(22, 27, 34, 0.75);
            --bg-card-hover: rgba(33, 38, 45, 0.9);
            --bg-input: #21262d;
            --border: #30363d;
            --border-hover: #58a6ff;
            --text-main: #f0f6fc;
            --text-muted: #8b949e;
            --accent-primary: #238636;
            --accent-secondary: #58a6ff;
            --accent-tertiary: #a371f7;
            --accent-glow: rgba(35, 134, 54, 0.25);
            --heat-0: #161b22;
            --heat-1: #0e4429;
            --heat-2: #006d32;
            --heat-3: #26a641;
            --heat-4: #39d353;
            --status-active: #39d353;
            --status-building: #d29922;
            --card-shadow: 0 8px 24px 0 rgba(0, 0, 0, 0.5);
            --font-mono: 'JetBrains Mono', monospace;
        }

        :root[data-theme="emerald-obsidian"] {
            --bg-primary: #040d0a;
            --bg-secondary: #081712;
            --bg-card: rgba(10, 28, 22, 0.75);
            --bg-card-hover: rgba(16, 42, 33, 0.9);
            --bg-input: #112e24;
            --border: rgba(16, 185, 129, 0.22);
            --border-hover: rgba(245, 158, 11, 0.5);
            --text-main: #ecfdf5;
            --text-muted: #6ee7b7;
            --accent-primary: #10b981;
            --accent-secondary: #f59e0b;
            --accent-tertiary: #14b8a6;
            --accent-glow: rgba(16, 185, 129, 0.25);
            --heat-0: #0d231c;
            --heat-1: #064e3b;
            --heat-2: #047857;
            --heat-3: #10b981;
            --heat-4: #34d399;
            --status-active: #34d399;
            --status-building: #fbbf24;
            --card-shadow: 0 8px 32px 0 rgba(2, 20, 14, 0.6);
            --font-mono: 'JetBrains Mono', monospace;
        }

        :root[data-theme="sunset-glow"] {
            --bg-primary: #0f111a;
            --bg-secondary: #171926;
            --bg-card: rgba(26, 29, 45, 0.75);
            --bg-card-hover: rgba(38, 42, 64, 0.9);
            --bg-input: #23273b;
            --border: rgba(249, 115, 22, 0.22);
            --border-hover: rgba(244, 63, 94, 0.5);
            --text-main: #fff7ed;
            --text-muted: #fdba74;
            --accent-primary: #f97316;
            --accent-secondary: #f43f5e;
            --accent-tertiary: #eab308;
            --accent-glow: rgba(249, 115, 22, 0.25);
            --heat-0: #1f2235;
            --heat-1: #7c2d12;
            --heat-2: #c2410c;
            --heat-3: #ea580c;
            --heat-4: #fb923c;
            --status-active: #10b981;
            --status-building: #eab308;
            --card-shadow: 0 8px 32px 0 rgba(10, 8, 20, 0.6);
            --font-mono: 'JetBrains Mono', monospace;
        }

        :root[data-theme="clean-light"] {
            --bg-primary: #f8fafc;
            --bg-secondary: #ffffff;
            --bg-card: rgba(255, 255, 255, 0.85);
            --bg-card-hover: #ffffff;
            --bg-input: #f1f5f9;
            --border: #e2e8f0;
            --border-hover: #6366f1;
            --text-main: #0f172a;
            --text-muted: #64748b;
            --accent-primary: #4f46e5;
            --accent-secondary: #0284c7;
            --accent-tertiary: #0d9488;
            --accent-glow: rgba(79, 70, 229, 0.15);
            --heat-0: #f1f5f9;
            --heat-1: #c7d2fe;
            --heat-2: #818cf8;
            --heat-3: #6366f1;
            --heat-4: #4338ca;
            --status-active: #16a34a;
            --status-building: #d97706;
            --card-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.05);
            --font-mono: 'JetBrains Mono', monospace;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            transition: background-color 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease;
        }

        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            background: var(--bg-primary);
            color: var(--text-main);
            min-height: 100vh;
            display: flex;
            overflow-x: hidden;
        }

        /* Glassmorphism utility */
        .glass {
            background: var(--bg-card);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border: 1px solid var(--border);
            box-shadow: var(--card-shadow);
        }

        .sidebar {
            width: 260px;
            height: 100vh;
            position: fixed;
            left: 0;
            top: 0;
            z-index: 100;
            display: flex;
            flex-direction: column;
            padding: 24px 16px;
            background: var(--bg-secondary);
            border-right: 1px solid var(--border);
        }

        .brand {
            display: flex;
            align-items: center;
            gap: 14px;
            padding: 0 8px;
            margin-bottom: 36px;
        }

        .brand-logo {
            width: 42px;
            height: 42px;
            border-radius: 12px;
            background: linear-gradient(135deg, var(--accent-primary), var(--accent-secondary));
            display: flex;
            align-items: center;
            justify-content: center;
            color: #fff;
            box-shadow: 0 0 15px var(--accent-glow);
        }

        .brand-text h2 {
            font-size: 16px;
            font-weight: 800;
            letter-spacing: -0.5px;
        }

        .brand-text span {
            font-size: 11px;
            color: var(--text-muted);
            font-family: var(--font-mono);
            letter-spacing: 1px;
            text-transform: uppercase;
        }

        nav {
            display: flex;
            flex-direction: column;
            gap: 6px;
        }

        .nav-item {
            border: none;
            background: transparent;
            color: var(--text-muted);
            padding: 12px 16px;
            border-radius: 10px;
            cursor: pointer;
            display: flex;
            align-items: center;
            gap: 12px;
            font-size: 13px;
            font-weight: 600;
            width: 100%;
            text-align: left;
            position: relative;
        }

        .nav-item:hover {
            background: var(--bg-card-hover);
            color: var(--text-main);
        }

        .nav-item.active {
            background: var(--accent-glow);
            color: var(--accent-primary);
            border: 1px solid var(--border);
        }

        .nav-item i {
            width: 18px;
            height: 18px;
        }

        .sidebar-bottom {
            margin-top: auto;
            display: flex;
            flex-direction: column;
            gap: 16px;
        }

        .status-badge {
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 8px 12px;
            border-radius: 20px;
            background: rgba(16, 185, 129, 0.1);
            border: 1px solid rgba(16, 185, 129, 0.2);
            font-size: 11px;
            color: var(--status-active);
            font-weight: 600;
        }

        .pulse-dot {
            width: 8px;
            height: 8px;
            background: var(--status-active);
            border-radius: 50%;
            box-shadow: 0 0 8px var(--status-active);
            animation: pulse 2s infinite;
        }

        @keyframes pulse {
            0% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.7); }
            70% { transform: scale(1); box-shadow: 0 0 0 8px rgba(16, 185, 129, 0); }
            100% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(16, 185, 129, 0); }
        }

        .profile-mini {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 10px;
            border-radius: 12px;
            background: var(--bg-card);
            border: 1px solid var(--border);
        }

        .avatar {
            width: 36px;
            height: 36px;
            border-radius: 50%;
            background: linear-gradient(135deg, var(--accent-primary), var(--accent-tertiary));
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 700;
            color: #fff;
            font-size: 13px;
        }

        .main {
            margin-left: 260px;
            padding: 32px 40px;
            width: calc(100% - 260px);
            max-width: 1500px;
        }

        .topbar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 32px;
            gap: 20px;
        }

        .greeting-label {
            font-family: var(--font-mono);
            font-size: 11px;
            letter-spacing: 2px;
            color: var(--accent-primary);
            text-transform: uppercase;
            font-weight: 700;
            margin-bottom: 4px;
        }

        .topbar h1 {
            font-size: 28px;
            font-weight: 800;
            letter-spacing: -0.5px;
        }

        .topbar h1 span {
            background: linear-gradient(135deg, var(--accent-primary), var(--accent-secondary));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .subtitle {
            color: var(--text-muted);
            font-size: 13px;
            margin-top: 4px;
        }

        .top-actions {
            display: flex;
            align-items: center;
            gap: 12px;
            position: relative;
        }

        /* Theme Selector Menu */
        .theme-selector-wrapper {
            position: relative;
        }

        .theme-btn {
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 9px 16px;
            border-radius: 10px;
            background: var(--bg-card);
            border: 1px solid var(--border);
            color: var(--text-main);
            font-size: 13px;
            font-weight: 600;
            cursor: pointer;
        }

        .theme-btn:hover {
            border-color: var(--border-hover);
            box-shadow: 0 0 12px var(--accent-glow);
        }

        .theme-dropdown {
            position: absolute;
            right: 0;
            top: calc(100% + 8px);
            width: 240px;
            border-radius: 14px;
            padding: 8px;
            display: none;
            flex-direction: column;
            gap: 4px;
            z-index: 200;
        }

        .theme-dropdown.show {
            display: flex;
            animation: fadeIn 0.2s ease;
        }

        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(-8px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .theme-option {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 10px 12px;
            border-radius: 8px;
            border: none;
            background: transparent;
            color: var(--text-main);
            font-size: 12px;
            font-weight: 600;
            cursor: pointer;
            width: 100%;
        }

        .theme-option:hover {
            background: var(--bg-card-hover);
        }

        .theme-option.active {
            background: var(--accent-glow);
            color: var(--accent-primary);
        }

        .theme-preview-dots {
            display: flex;
            gap: 4px;
        }

        .dot {
            width: 10px;
            height: 10px;
            border-radius: 50%;
        }

        .icon-button {
            width: 40px;
            height: 40px;
            border-radius: 10px;
            border: 1px solid var(--border);
            background: var(--bg-card);
            color: var(--text-main);
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            position: relative;
        }

        .icon-button:hover {
            border-color: var(--border-hover);
            color: var(--accent-primary);
        }

        .badge-dot {
            position: absolute;
            top: 8px;
            right: 8px;
            width: 8px;
            height: 8px;
            background: var(--accent-primary);
            border-radius: 50%;
        }

        .stats-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
            gap: 16px;
            margin-bottom: 24px;
        }

        .stat-card {
            border-radius: 14px;
            padding: 20px;
            display: flex;
            gap: 16px;
            position: relative;
            overflow: hidden;
        }

        .stat-card:hover {
            transform: translateY(-3px);
            border-color: var(--border-hover);
        }

        .stat-icon {
            width: 44px;
            height: 44px;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            background: var(--accent-glow);
            color: var(--accent-primary);
            flex-shrink: 0;
        }

        .stat-content p {
            font-size: 11px;
            color: var(--text-muted);
            text-transform: uppercase;
            letter-spacing: 0.5px;
            font-weight: 700;
        }

        .stat-content h2 {
            font-size: 26px;
            font-weight: 800;
            margin: 4px 0;
            font-family: var(--font-mono);
        }

        .stat-content small {
            font-size: 11px;
            color: var(--text-muted);
        }

        .tag-green {
            color: var(--status-active);
            font-weight: 700;
        }

        /* Grid layout sections */
        .content-grid {
            display: grid;
            grid-template-columns: 2fr 1fr;
            gap: 20px;
            margin-bottom: 24px;
        }

        .card {
            border-radius: 16px;
            padding: 24px;
        }

        .card-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 20px;
        }

        .card-header h2 {
            font-size: 16px;
            font-weight: 700;
        }

        .select-input {
            background: var(--bg-input);
            color: var(--text-main);
            border: 1px solid var(--border);
            padding: 6px 12px;
            border-radius: 8px;
            font-size: 12px;
            outline: none;
            cursor: pointer;
        }

        .heatmap-container {
            overflow-x: auto;
            padding-bottom: 8px;
        }

        .heatmap {
            display: grid;
            grid-template-columns: repeat(26, 1fr);
            grid-template-rows: repeat(7, 14px);
            gap: 5px;
            min-width: 500px;
        }

        .heat-cell {
            background: var(--heat-0);
            border-radius: 3px;
            cursor: pointer;
            position: relative;
        }

        .heat-cell:hover {
            transform: scale(1.3);
            z-index: 10;
            box-shadow: 0 0 10px var(--accent-primary);
        }

        .heat-1 { background: var(--heat-1); }
        .heat-2 { background: var(--heat-2); }
        .heat-3 { background: var(--heat-3); }
        .heat-4 { background: var(--heat-4); }

        .legend {
            display: flex;
            align-items: center;
            gap: 6px;
            margin-top: 16px;
            font-size: 11px;
            color: var(--text-muted);
            justify-content: flex-end;
        }

        .legend i {
            width: 12px;
            height: 12px;
            border-radius: 3px;
            display: inline-block;
        }

        /* Skills */
        .skill-item {
            margin-bottom: 16px;
        }

        .skill-info {
            display: flex;
            justify-content: space-between;
            font-size: 12px;
            font-weight: 600;
            margin-bottom: 6px;
        }

        .skill-bar-bg {
            height: 8px;
            background: var(--bg-input);
            border-radius: 10px;
            overflow: hidden;
            position: relative;
        }

        .skill-bar-fill {
            height: 100%;
            background: linear-gradient(90deg, var(--accent-primary), var(--accent-secondary));
            border-radius: 10px;
            width: 0%;
            transition: width 1s cubic-bezier(0.4, 0, 0.2, 1);
        }

        .projects-section {
            margin-bottom: 24px;
        }

        .filter-tags {
            display: flex;
            gap: 8px;
        }

        .tag-btn {
            background: var(--bg-input);
            border: 1px solid var(--border);
            color: var(--text-muted);
            padding: 5px 12px;
            border-radius: 20px;
            font-size: 11px;
            font-weight: 600;
            cursor: pointer;
        }

        .tag-btn.active {
            background: var(--accent-primary);
            color: #ffffff;
            border-color: var(--accent-primary);
        }

        .projects-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
            gap: 16px;
        }

        .project-card {
            border-radius: 12px;
            padding: 16px;
            display: flex;
            gap: 14px;
            border: 1px solid var(--border);
            background: var(--bg-card);
        }

        .project-card:hover {
            transform: translateY(-2px);
            border-color: var(--border-hover);
            background: var(--bg-card-hover);
        }

        .project-icon-box {
            width: 40px;
            height: 40px;
            border-radius: 10px;
            background: var(--accent-glow);
            color: var(--accent-primary);
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
        }

        .project-details h3 {
            font-size: 13px;
            font-weight: 700;
        }

        .project-details p {
            font-size: 11px;
            color: var(--text-muted);
            margin: 4px 0 10px 0;
        }

        .project-tags {
            display: flex;
            gap: 12px;
            font-size: 10px;
            font-weight: 600;
        }

        .status-building { color: var(--status-building); }
        .status-active { color: var(--status-active); }

        .bottom-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 20px;
        }

        .achievement-item {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 12px;
            border-radius: 10px;
            border: 1px solid var(--border);
            background: var(--bg-input);
            margin-bottom: 10px;
        }

        .achievement-icon {
            font-size: 20px;
        }

        .achievement-info strong {
            display: block;
            font-size: 12px;
        }

        .achievement-info small {
            font-size: 10px;
            color: var(--text-muted);
        }

        .achievement-item.locked {
            opacity: 0.4;
        }

        .activity-feed {
            display: flex;
            flex-direction: column;
            gap: 16px;
        }

        .activity-item {
            display: flex;
            gap: 12px;
            align-items: flex-start;
        }

        .activity-dot-line {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 4px;
        }

        .act-dot {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            background: var(--accent-primary);
            box-shadow: 0 0 8px var(--accent-primary);
        }

        .activity-info strong {
            font-size: 12px;
            display: block;
        }

        .activity-info small {
            font-size: 10px;
            color: var(--text-muted);
        }

        /* Tooltip */
        #tooltip {
            position: absolute;
            background: var(--bg-secondary);
            color: var(--text-main);
            border: 1px solid var(--border);
            padding: 6px 10px;
            border-radius: 6px;
            font-size: 11px;
            pointer-events: none;
            display: none;
            z-index: 1000;
            box-shadow: var(--card-shadow);
        }

        /* Responsive Breakpoints */
        @media (max-width: 1024px) {
            .sidebar { width: 80px; padding: 20px 10px; }
            .brand-text, .nav-item span, .status-badge span, .profile-mini div { display: none; }
            .main { margin-left: 80px; width: calc(100% - 80px); padding: 24px; }
            .content-grid { grid-template-columns: 1fr; }
        }

        @media (max-width: 768px) {
            body { flex-direction: column; }
            .sidebar { width: 100%; height: auto; position: relative; border-right: none; border-bottom: 1px solid var(--border); }
            nav { flex-direction: row; justify-content: space-around; }
            .sidebar-bottom { display: none; }
            .main { margin-left: 0; width: 100%; padding: 16px; }
            .bottom-grid { grid-template-columns: 1fr; }
            .topbar { flex-direction: column; align-items: flex-start; gap: 16px; }
        }
    </style>
</head>

<body>

    <!-- Tooltip Element -->
    <div id="tooltip"></div>

    <!-- ================= SIDEBAR ================= -->
    <aside class="sidebar">
        <div class="brand">
            <div class="brand-logo">
                <i data-lucide="github"></i>
            </div>
            <div class="brand-text">
                <h2>GitHub</h2>
                <span>Dashboard</span>
            </div>
        </div>

        <nav>
            <button class="nav-item active" data-section="dashboard">
                <i data-lucide="layout-dashboard"></i>
                <span>Dashboard</span>
            </button>
            <button class="nav-item" data-section="projects">
                <i data-lucide="folder-git-2"></i>
                <span>Projects</span>
            </button>
            <button class="nav-item" data-section="activity">
                <i data-lucide="activity"></i>
                <span>Activity</span>
            </button>
            <button class="nav-item" data-section="skills">
                <i data-lucide="cpu"></i>
                <span>Skills</span>
            </button>
            <button class="nav-item" data-section="achievements">
                <i data-lucide="award"></i>
                <span>Achievements</span>
            </button>
        </nav>

        <div class="sidebar-bottom">
